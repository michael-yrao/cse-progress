#!/bin/sh
# Version-controlled pre-commit hook (tracked in .githooks/, used via core.hooksPath).
# One-time setup per machine/clone:   git config core.hooksPath .githooks
#
# Auto-updates the DSA spaced-repetition tracker before commit when it (or any solution
# file under a configured root) is staged: recomputes review dates and re-sorts the table.
# Paths are read from cse.config.yml by the script.
#
# (The AI tracker was removed with the AI track on Aug 13, 2026. The System Design tracker
# left on Aug 15, 2026 and CAME BACK on Aug 16 — only HelloInterview-excerpt material stayed
# private, and a tracker of question names + comfort + dates is not that. It is handled by the
# second block below, with --tracker rather than source discovery: there are no SD source files.)
# ⚠️ Git runs this hook with a console in the system ANSI codepage (cp1252 on Windows).
# Python inherits it, and the FIRST emoji any script below prints — ✅, ⚠️, a comfort glyph
# in a problem title — raises UnicodeEncodeError and kills that script mid-report.
#
# The failure is worse than a crash because every block here is report-only and ends in
# `|| true`: the traceback scrolls past, the commit succeeds, and the check LOOKS like it
# ran. Found Aug 21, 2026 — reconcile.py fired exactly as designed, at the one moment a
# decision is recorded, and printed a traceback instead of the backlog.
#
# Belt and braces with scripts/_console.py: this covers every script this hook invokes,
# including ones added later that forget the import; that module covers every other context
# (Git Bash, a piped run, CI), where nothing sets this variable.
export PYTHONIOENCODING=utf-8

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
if echo "$STAGED" | grep -qE "dsa_progress\.md$|^dsa/leetcode/.*\.(py|java|ts|js|cpp)$"; then
  echo "Auto-updating the DSA spaced-repetition tracker..."
  if command -v py >/dev/null 2>&1; then
    py scripts/update_review_dates.py --staged-only
  elif command -v python >/dev/null 2>&1; then
    python scripts/update_review_dates.py --staged-only
  elif command -v python3 >/dev/null 2>&1; then
    python3 scripts/update_review_dates.py --staged-only
  else
    echo "Error: Python not found. Install Python to enable the auto-updater." >&2
    exit 1
  fi
  DSA="docs/foundations/dsa/mastery/dsa_progress.md"
  [ -f "$DSA" ] && git add "$DSA"
fi

# System Design tracker. Same 7-column table and the same interval math as the DSA one, but
# --tracker instead of --staged-only: rows are added by hand and there is nothing to discover.
if echo "$STAGED" | grep -qE "design_progress\.md$"; then
  echo "Auto-updating the System Design tracker..."
  SD="docs/foundations/system_design/mastery/design_progress.md"
  if command -v py >/dev/null 2>&1; then
    py scripts/update_review_dates.py --tracker "$SD"
  elif command -v python >/dev/null 2>&1; then
    python scripts/update_review_dates.py --tracker "$SD"
  elif command -v python3 >/dev/null 2>&1; then
    python3 scripts/update_review_dates.py --tracker "$SD"
  else
    echo "Error: Python not found. Install Python to enable the auto-updater." >&2
    exit 1
  fi
  [ -f "$SD" ] && git add "$SD"
fi

# Technique coverage. Keyed by TECHNIQUE rather than by problem, so it answers "is
# Dijkstra actually learned" — a question the per-problem tracker structurally cannot.
# Must run AFTER the block above, which rewrites dsa_progress.md; this reads it.
COVERAGE_TRIGGER=$(echo "$STAGED" | grep -E "dsa_progress\.md$|techniques\.yml$|^dsa/leetcode/.*\.(py|java|ts|js|cpp)$")
if [ -n "$COVERAGE_TRIGGER" ]; then
  echo "Regenerating technique coverage..."
  COVERAGE="docs/foundations/dsa/mastery/technique_coverage.md"
  if command -v py >/dev/null 2>&1; then
    py scripts/technique_coverage.py
  elif command -v python >/dev/null 2>&1; then
    python scripts/technique_coverage.py
  elif command -v python3 >/dev/null 2>&1; then
    python3 scripts/technique_coverage.py
  fi
  # Non-fatal by design: a missing PyYAML or a hand-edit mid-refactor of techniques.yml
  # must not block committing the day's actual work. The report simply goes stale, and
  # `technique_coverage.py --check` reports that.
  [ -f "$COVERAGE" ] && git add "$COVERAGE"
fi

# Single source of truth for tuned values (see CLAUDE.md). Fires when the config, a script
# that carries defaults, or a rules document is staged — i.e. exactly the three places a
# value can be copied to. Reports; never blocks.
#
# ⚠️ WARN-ONLY ON PURPOSE. The prose half of this check is heuristic (it cannot tell
# "+2 days" as a rule from "+2 days" inside a dated log entry), and a heuristic that can
# block a commit gets disabled within a week — at which point the check exists and never
# fires, which is the failure it was written to prevent. The exact half (script defaults vs
# config) is loud enough to act on: it prints ❌ and names both files.
SSOT_TRIGGER=$(echo "$STAGED" | grep -E "cse\.config\.yml$|^scripts/.*\.py$|CLAUDE\.md$|^docs/foundations/.*\.md$")
if [ -n "$SSOT_TRIGGER" ]; then
  if command -v py >/dev/null 2>&1; then
    py scripts/check_single_source.py || true
  elif command -v python >/dev/null 2>&1; then
    python scripts/check_single_source.py || true
  elif command -v python3 >/dev/null 2>&1; then
    python3 scripts/check_single_source.py || true
  fi
fi

# Schedule integrity. Fires when a rating lands (the tracker) or the board is edited — the two
# ways a done rep and its schedule row can drift apart. Checks only the CURRENT week's file:
# a struck row must carry its End + Next, and a rep the tracker dates inside this week must be
# struck. Report-only, and silent-when-clean by design.
#
# ⚠️ It deliberately does NOT check that every future review date is pre-placed in some schedule
# file. That reading of the rule reports 73 of 115 rows on a healthy repo — distant dates are
# pulled by the weekly build's tracker sweep, not pushed row by row. See the script's docstring.
if echo "$STAGED" | grep -qE "dsa_progress\.md$|design_progress\.md$|^docs/foundations/schedules/.*\.md$"; then
  if command -v py >/dev/null 2>&1; then
    py scripts/check_schedule_integrity.py || true
  elif command -v python >/dev/null 2>&1; then
    python scripts/check_schedule_integrity.py || true
  elif command -v python3 >/dev/null 2>&1; then
    python3 scripts/check_schedule_integrity.py || true
  fi
fi

# Rule reconciliation. Fires ONLY when decisions.yml is staged — i.e. the moment a decision
# is recorded, which is exactly when the blast radius is worth seeing and when it is cheapest
# to act on. Running it on every commit would print a 40-line backlog daily until someone
# stopped reading it.
#
# Report-only, always: a rule that has not been re-read is not a broken commit, and the whole
# design assumes reconciling is a deliberate human act (see scripts/reconcile.py).
if echo "$STAGED" | grep -qE "^decisions\.yml$"; then
  echo "A decision was recorded — rules not yet read against it:"
  if command -v py >/dev/null 2>&1; then
    py scripts/reconcile.py || true
  elif command -v python >/dev/null 2>&1; then
    python scripts/reconcile.py || true
  elif command -v python3 >/dev/null 2>&1; then
    python3 scripts/reconcile.py || true
  fi
fi
exit 0
