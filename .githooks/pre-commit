#!/bin/sh
# Version-controlled pre-commit hook (tracked in .githooks/, used via core.hooksPath).
# One-time setup per machine/clone:   git config core.hooksPath .githooks
#
# Auto-updates the spaced-repetition trackers before commit when a tracker (or any
# solution file under a configured root) is staged: recomputes review dates and
# re-sorts the table. Pillars and paths are read from cse.config.yml by the script.
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
if echo "$STAGED" | grep -qE "(dsa_progress|design_progress)\.md$|^dsa/leetcode/.*\.(py|java|ts|js|cpp)$"; then
  echo "Auto-updating spaced-repetition tracker(s)..."
  # DSA runs the full engine (--staged-only, source discovery); the System Design
  # tracker is recomputed + re-sorted via --tracker (no discovery).
  # recompute_simple() no-ops if a tracker file doesn't exist yet.
  # (The AI tracker was removed with the AI track on Aug 13, 2026.)
  SD="docs/foundations/system_design/mastery/design_progress.md"
  if command -v py >/dev/null 2>&1; then
    py scripts/update_review_dates.py --staged-only --tracker "$SD"
  elif command -v python >/dev/null 2>&1; then
    python scripts/update_review_dates.py --staged-only --tracker "$SD"
  elif command -v python3 >/dev/null 2>&1; then
    python3 scripts/update_review_dates.py --staged-only --tracker "$SD"
  else
    echo "Error: Python not found. Install Python to enable the auto-updater." >&2
    exit 1
  fi
  # Re-stage only the trackers that exist. A single `git add` listing a missing
  # path aborts the whole command and stages nothing — silently, leaving the
  # regeneration uncommitted (a one-commit lag). Add each individually so one
  # absent file can't abort the rest.
  DSA="docs/foundations/dsa/mastery/dsa_progress.md"
  for tracker in "$DSA" "$SD"; do
    [ -f "$tracker" ] && git add "$tracker"
  done
fi

# Technique coverage. Keyed by TECHNIQUE rather than by problem, so it answers "is
# Dijkstra actually learned" — a question the per-problem tracker structurally cannot.
# Must run AFTER the block above, which rewrites dsa_progress.md; this reads it.
COVERAGE_TRIGGER=$(echo "$STAGED" | grep -E "dsa_progress\.md$|techniques\.yml$|^dsa/leetcode/.*\.(py|java|ts|js|cpp)$")
if [ -n "$COVERAGE_TRIGGER" ]; then
  echo "Regenerating technique coverage..."
  COVERAGE="docs/foundations/dsa/mastery/technique_coverage.md"
  if command -v py >/dev/null 2>&1; then
    py scripts/technique_coverage.py
  elif command -v python >/dev/null 2>&1; then
    python scripts/technique_coverage.py
  elif command -v python3 >/dev/null 2>&1; then
    python3 scripts/technique_coverage.py
  fi
  # Non-fatal by design: a missing PyYAML or a hand-edit mid-refactor of techniques.yml
  # must not block committing the day's actual work. The report simply goes stale, and
  # `technique_coverage.py --check` reports that.
  [ -f "$COVERAGE" ] && git add "$COVERAGE"
fi
exit 0
