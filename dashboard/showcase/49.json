{"schemaVersion":1,"generatedAt":"2026-10-09","entries":[{"key":"49:sort-key-map","lcNumber":49,"variant":"sort-key-map","title":"Group Anagrams","url":"https://leetcode.com/problems/group-anagrams/","file":"dsa/leetcode/arrays_and_hash/49_group_anagrams.py","symbol":"groupAnagrams","attemptDate":null,"segments":[{"kind":"container","symbol":"Solution","startLine":49,"endLine":49,"lines":["class Solution:"]},{"kind":"attempt","symbol":"groupAnagrams","startLine":63,"endLine":72,"lines":["    def groupAnagrams(self, strs: List[str]) -> List[List[str]]:","        anagramMap = {}","        for str in strs:","            sortedStr = ''.join(sorted(str))","            # need to initialize key if we use default map","            # otherwise, we run into KeyError issue","            if sortedStr not in anagramMap:","                anagramMap[sortedStr] = []","            anagramMap[sortedStr].append(str)","        return list(anagramMap.values())"]}]},{"key":"49:defaultdict","lcNumber":49,"variant":"defaultdict","title":"Group Anagrams","url":"https://leetcode.com/problems/group-anagrams/","file":"dsa/leetcode/arrays_and_hash/49_group_anagrams.py","symbol":"groupAnagramsAlternative","attemptDate":null,"segments":[{"kind":"container","symbol":"Solution","startLine":49,"endLine":49,"lines":["class Solution:"]},{"kind":"attempt","symbol":"groupAnagramsAlternative","startLine":74,"endLine":81,"lines":["    def groupAnagramsAlternative(self, strs: List[str]) -> List[List[str]]:","        # preferred concise and idiomatic code since ","        # defaultdict stores default empty list for non-existing keys","        anagramMap = defaultdict(list)","        for str in strs:","            sortedStr = ''.join(sorted(str))","            anagramMap[sortedStr].append(str)","        return list(anagramMap.values())"]}]}]}
