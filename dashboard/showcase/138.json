{"schemaVersion":1,"generatedAt":"2026-10-09","entries":[{"key":"138:two-pass-map","lcNumber":138,"variant":"two-pass-map","title":"Copy List with Random Pointer","url":"https://leetcode.com/problems/copy-list-with-random-pointer/","file":"dsa/leetcode/linked_list/138_copy_list_with_random_pointer.py","symbol":"copyRandomList_20260804","attemptDate":"2026-08-04","segments":[{"kind":"helper","symbol":"Node","startLine":42,"endLine":46,"lines":["class Node:","    def __init__(self, x: int, next: 'Node' = None, random: 'Node' = None): # type: ignore","        self.val = int(x)","        self.next = next","        self.random = random"]},{"kind":"container","symbol":"Solution","startLine":48,"endLine":48,"lines":["class Solution:"]},{"kind":"attempt","symbol":"copyRandomList_20260804","startLine":101,"endLine":133,"lines":["    # ── Attempt · 2026-08-04 ──────────────","    def copyRandomList_20260804(self, head: 'Optional[Node]') -> 'Optional[Node]':","        # to perform a deep copy, we need to create a map of old to new","        # so we go through the list, create a copy and link each old node to the new node via the map","","        oldToNewMap = {}","","        traversal = head","","        # construct the map","        while traversal:","            newNode = Node(traversal.val)","            oldToNewMap[traversal] = newNode","            traversal = traversal.next","","        traversal = head","        # map next","        while traversal:","            newNext = None","            if traversal.next:","                newNext = oldToNewMap[traversal.next]","            oldToNewMap[traversal].next = newNext","            traversal = traversal.next","","        # go through the map and set the random","        for old, new in oldToNewMap.items():","            if old.random:","                newRandom = oldToNewMap[old.random]","                new.random = newRandom","","        if not head:","            return None","        return oldToNewMap[head]"]}]}]}
