  def productExceptSelfPrefixSumEfficient(self, nums: List[int]) -> List[int]:","        # take advantage of the fact that result does not count towards space complexity","        # store prefix in result, using a variable to help","        # then loop through again multiplying by suffix, using another variable to help","","        result = [1] * len(nums)","","        prefix = suffix = 1","","        for i in range(len(nums)):","            result[i] = prefix","            prefix *= nums[i]","","        for i in range(len(nums)-1,-1,-1):","            result[i] *= suffix","            suffix *= nums[i]","        ","        return result"]}]}]}
