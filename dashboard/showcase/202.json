{"schemaVersion":1,"generatedAt":"2026-10-08","entries":[{"key":"202:seen-set","lcNumber":202,"variant":"seen-set","title":"Happy Number","url":"https://leetcode.com/problems/happy-number/","file":"dsa/leetcode/graphs/202_happy_number.py","symbol":"isHappy_20260902","attemptDate":"2026-09-02","segments":[{"kind":"container","symbol":"Solution","startLine":35,"endLine":35,"lines":["class Solution:"]},{"kind":"attempt","symbol":"isHappy_20260902","startLine":56,"endLine":72,"lines":["    # ── Attempt · 2026-09-02 ──────────────","    def isHappy_20260902(self, n: int) -> bool:","        # if we have seen this number, we are repeating, so a set","        seen = set()","","        # now we do the happy number logic","        while n not in seen:","            # add n itself to seen","            seen.add(n)","            currentNum = 0","            for digit in str(n):","                currentNum+=int(digit)**2","            n = currentNum","            if n == 1:","                return True","        ","        return False"]}]}]}
