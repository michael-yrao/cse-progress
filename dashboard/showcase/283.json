{"schemaVersion":1,"generatedAt":"2026-10-06","entries":[{"key":"283:two-pointers","lcNumber":283,"variant":"two-pointers","title":"Move Zeroes","url":"https://leetcode.com/problems/move-zeroes/","file":"dsa/leetcode/two_pointers/283_move_zeros.py","symbol":"moveZeroes_20260919","attemptDate":"2026-09-19","segments":[{"kind":"container","symbol":"Solution","startLine":30,"endLine":30,"lines":["class Solution:"]},{"kind":"attempt","symbol":"moveZeroes_20260919","startLine":32,"endLine":48,"lines":["    # ── Attempt · 2026-09-19 ──────────────","    def moveZeroes_20260919(self, nums: List[int]) -> None:","        # two pointers, we can use left as a pointer to define where to put the next 0","        # we will use right to traverse the array","        # time complexity is O(n) since we have to go through the whole array","        # space complexity is O(1) with no extra space other than the two pointers","        ","        left = right = 0","        ","        while right < len(nums):","            # if we see a nonzero number, swap with left","            if nums[right] != 0:","                tmp = nums[left]","                nums[left] = nums[right]","                nums[right] = tmp","                left+=1","            right+=1"]}]}]}
