{"schemaVersion":1,"generatedAt":"2026-10-09","entries":[{"key":"739:monotonic-stack","lcNumber":739,"variant":"monotonic-stack","title":"Daily Temperatures","url":"https://leetcode.com/problems/daily-temperatures/","file":"dsa/leetcode/stack/739_daily_temperatures.py","symbol":"dailyTemperatures_20260906","attemptDate":"2026-09-06","segments":[{"kind":"container","symbol":"Solution","startLine":29,"endLine":29,"lines":["class Solution:"]},{"kind":"attempt","symbol":"dailyTemperatures_20260906","startLine":31,"endLine":53,"lines":["    # ── Attempt · 2026-09-06 ──────────────","    def dailyTemperatures_20260906(self, temperatures: List[int]) -> List[int]:","        # from the result, we can tell the indices matter since we are saying","        # from index 2, the next higher temperature is index 6","        # next higher = monotonic stack/deque","        # since we want next higher, we should do monotonically decreasing","","        result = [0] * len(temperatures)","","        decreasingStack = []","","        for i in range(len(temperatures)):","            # while we go against the rule of decreasing stack, pop","            # while we pop, we should also start marking the results for these","            while decreasingStack and temperatures[i] > temperatures[decreasingStack[-1]]:","                # i - decreasingStack[-1] is the diff","                priorLowerIndex = decreasingStack.pop()","                nextGreaterDiff = i - priorLowerIndex","                result[priorLowerIndex] = nextGreaterDiff","            # now that we are not breaking the decreasing rule, append","            decreasingStack.append(i)","        ","        return result"]}]}]}
