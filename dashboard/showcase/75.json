{"schemaVersion":1,"generatedAt":"2026-10-05","entries":[{"key":"75:dutch-flag","lcNumber":75,"variant":"dutch-flag","title":"Sort Colors","url":"https://leetcode.com/problems/sort-colors/","file":"dsa/leetcode/arrays_and_hash/75_sort_colors.py","symbol":"sortColors_20260816","attemptDate":"2026-08-16","segments":[{"kind":"container","symbol":"Solution","startLine":33,"endLine":33,"lines":["class Solution:"]},{"kind":"attempt","symbol":"sortColors_20260816","startLine":35,"endLine":63,"lines":["    # ── Attempt · 2026-08-16 ──────────────","    def sortColors_20260816(self, nums: List[int]) -> None:","        \"\"\"","        Do not return anything, modify nums in-place instead.","        \"\"\"","        # Dutch Flag algorithm","        # three pointers","        # l, t, r","        # everything before l is set in place with 0s, r tracks 2s","        # t goes through the array and swaps with l and r","        # everything before t is 0s and 1s set","        # when we swap with r, we need to not move t for us to recheck the value","","        l, t, r = 0, 0, len(nums) - 1","","        def swap(l,r):","            tmp = nums[l]","            nums[l] = nums[r]","            nums[r] = tmp","","        while t <= r:","            if nums[t] == 0:","                swap(l,t)","                l+=1","            elif nums[t] == 2:","                swap(t,r)","                r-=1","                t-=1","            t+=1"]}]},{"key":"75:bucket-sort","lcNumber":75,"variant":"bucket-sort","title":"Sort Colors","url":"https://leetcode.com/problems/sort-colors/","file":"dsa/leetcode/arrays_and_hash/75_sort_colors.py","symbol":"sortColorsBucketSort","attemptDate":null,"segments":[{"kind":"container","symbol":"Solution","startLine":33,"endLine":33,"lines":["class Solution:"]},{"kind":"attempt","symbol":"sortColorsBucketSort","startLine":92,"endLine":104,"lines":["    def sortColorsBucketSort(self, nums: List[int]) -> None:","        # since there's only 3 colors, we can just do count/bucket sort","        # and then loop through and replace","        countMap = {}","        for num in nums:","            countMap[num] = 1 + countMap.get(num,0)","        ","        index = 0","        for color in range(3):","            while countMap.get(color):","                nums[index] = color","                countMap[color] = countMap.get(color) - 1 # type: ignore","                index+=1"]}]}]}
