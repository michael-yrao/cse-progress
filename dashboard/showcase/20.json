{"schemaVersion":1,"generatedAt":"2026-10-06","entries":[{"key":"20:stack","lcNumber":20,"variant":"stack","title":"Valid Parentheses","url":"https://leetcode.com/problems/valid-parentheses/","file":"dsa/leetcode/stack/20_valid_parentheses.py","symbol":"isValid_20260808","attemptDate":"2026-08-08","segments":[{"kind":"container","symbol":"Solution","startLine":48,"endLine":48,"lines":["class Solution:"]},{"kind":"attempt","symbol":"isValid_20260808","startLine":50,"endLine":74,"lines":["    # ── Attempt · 2026-08-08 ──────────────","    def isValid_20260808(self, s: str) -> bool:","        # we keep a map of what is valid","        # so open to close or close to open, either works","        # we will do closed to open, since we want to push when it is an open bracket","        # pop when it is a closed bracket so check map's value on closed only","","        bracketMap = {'}':'{', ']':'[', ')':'('}","        stack = []","","        # we are given the chars can only be brackets","        # so we just push if it is not in the map","        # and pop if it is","        for char in s:","            if char not in bracketMap:","                stack.append(char)","            else:","                # if closed bracket and stack is empty, return false immediately","                if not stack:","                    return False","                # otherwise, check if top of the stack is the open bracket","                prevNode = stack.pop()","                if bracketMap[char] != prevNode:","                    return False","        return len(stack) == 0"]}]},{"key":"20:stack-set","lcNumber":20,"variant":"stack-set","title":"Valid Parentheses","url":"https://leetcode.com/problems/valid-parentheses/","file":"dsa/leetcode/stack/20_valid_parentheses.py","symbol":"isValidSet","attemptDate":null,"segments":[{"kind":"container","symbol":"Solution","startLine":48,"endLine":48,"lines":["class Solution:"]},{"kind":"attempt","symbol":"isValidSet","startLine":99,"endLine":122,"lines":["    def isValidSet(self, s: str) -> bool:","        # basically a bunch of if else statements","        # we can insert into stack on opening bracket","        # pop on ending if it matches, return False if not match","        # so one thing we can do is just do an open to close map","        ","        openToCloseMap = {'(' : ')', '{' : '}', '[' : ']'}","","        closeBrackets = set(openToCloseMap.values())","","        stack = deque()","","        for char in s:","            # check first if it is a closing bracket","            if char in closeBrackets:","                # if stack is empty and we see an closing bracket, return false","                # if map[peek] != char, also return false","                if not stack or openToCloseMap.get(stack[-1],None) != char:","                    return False","                # otherwise we got a match, pop out opening bracket","                stack.pop()","            if char in openToCloseMap:","                stack.append(char)","        return not stack"]}]}]}
