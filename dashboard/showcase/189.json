{"schemaVersion":1,"generatedAt":"2026-10-07","entries":[{"key":"189:three-reversals","lcNumber":189,"variant":"three-reversals","title":"Rotate Array","url":"https://leetcode.com/problems/rotate-array/","file":"dsa/leetcode/arrays_and_hash/189_rotate_array.py","symbol":"rotate_20260624","attemptDate":"2026-06-24","segments":[{"kind":"container","symbol":"Solution","startLine":42,"endLine":42,"lines":["class Solution:"]},{"kind":"attempt","symbol":"rotate_20260624","startLine":85,"endLine":104,"lines":["    def rotate_20260624(self, nums: List[int], k: int) -> None:","        \"\"\"","        Do not return anything, modify nums in-place instead.","        \"\"\"","        # [1,2,3,4] ; 2 ; initial state","        # [4,3,2,1] ; 2 ; reverse whole array","        # [3,4,1,2] ; reverse front k ; reverse back len - k","        k = k % len(nums)","","        def reverse(left, right):","            while left < right:","                tmp = nums[left]","                nums[left] = nums[right]","                nums[right] = tmp","                left+=1","                right-=1","","        reverse(0,len(nums)-1)","        reverse(0,k-1)","        reverse(k,len(nums)-1)"]}]}]}
