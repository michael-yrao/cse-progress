{"schemaVersion":1,"generatedAt":"2026-10-08","entries":[{"key":"347:min-heap","lcNumber":347,"variant":"min-heap","title":"Top K Frequent Elements","url":"https://leetcode.com/problems/top-k-frequent-elements/","file":"dsa/leetcode/arrays_and_hash/347_top_k_frequent_elements.py","symbol":"topKFrequent_20260530","attemptDate":"2026-05-30","segments":[{"kind":"container","symbol":"Solution","startLine":39,"endLine":39,"lines":["class Solution:"]},{"kind":"attempt","symbol":"topKFrequent_20260530","startLine":84,"endLine":107,"lines":["    def topKFrequent_20260530(self, nums: List[int], k: int) -> List[int]:","        # We can have create a frequency map first","        # After which, we can use a min heap","        # pop until we get the kth element","","        freqMap = {}","        for n in nums:","            freqMap[n] = 1 + freqMap.get(n,0)","        ","        heap = []","        for num in freqMap.keys():","            # default heap from heapq is a min heap","            heapq.heappush(heap, (freqMap[num],num))","            # since we only want the top k most frequent","            # we just pop if we have more than k since pop removes min","            if len(heap) > k:","                heapq.heappop(heap)","        ","        result = []","        # put heap onto result","        for freq, value in heap:","            result.append(value)","","        return result"]}]}]}
