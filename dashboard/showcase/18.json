{"schemaVersion":1,"generatedAt":"2026-10-09","entries":[{"key":"18:sort-two-pointers","lcNumber":18,"variant":"sort-two-pointers","title":"4Sum","url":"https://leetcode.com/problems/4sum/","file":"dsa/leetcode/two_pointers/18_four_sum.py","symbol":"fourSum_20260727","attemptDate":"2026-07-27","segments":[{"kind":"container","symbol":"Solution","startLine":32,"endLine":32,"lines":["class Solution:"]},{"kind":"attempt","symbol":"fourSum_20260727","startLine":34,"endLine":61,"lines":["    # ── Attempt · 2026-07-27 ──────────────","    def fourSum_20260727(self, nums: List[int], target: int) -> List[List[int]]:","        # treat like 3sum","        # sort and then use set to prevent duplicates","","        nums.sort()","        lenNums = len(nums)","        resultSet = set()","        for i in range(lenNums-3):","            for j in range(i+1, lenNums-2):","                k, l = j+1, len(nums) - 1","                runningTarget = target - nums[i] - nums[j]","                while k < l:","                    if nums[k] + nums[l] == runningTarget:","                        resultSet.add((nums[i], nums[j], nums[k], nums[l]))","                        k+=1","                        l-=1","                    elif nums[k] + nums[l] > runningTarget:","                        l-=1","                    else:","                        k+=1","        ","        result = []","","        for a,b,c,d in resultSet:","            result.append([a,b,c,d])","        ","        return result"]}]}]}
