{"schemaVersion":1,"generatedAt":"2026-10-09","entries":[{"key":"242:hash-map","lcNumber":242,"variant":"hash-map","title":"Valid Anagram","url":"https://leetcode.com/problems/valid-anagram/","file":"dsa/leetcode/arrays_and_hash/242_valid_anagram.py","symbol":"isAnagram","attemptDate":null,"segments":[{"kind":"container","symbol":"Solution","startLine":33,"endLine":33,"lines":["class Solution:"]},{"kind":"attempt","symbol":"isAnagram","startLine":50,"endLine":63,"lines":["    def isAnagram(self, s: str, t: str) -> bool:","        # anagrams are same length","        # anagrams are the same if sorted","        # anagrams also have the same # of each char, so hashmap","        sMap, tMap = {}, {}","","        if len(s) != len(t): ","            return False","        ","        for i in range(len(s)):","            sMap[s[i]] = 1 + sMap.get(s[i],0)","            tMap[t[i]] = 1 + tMap.get(t[i],0)","","        return sMap == tMap"]}]},{"key":"242:sort","lcNumber":242,"variant":"sort","title":"Valid Anagram","url":"https://leetcode.com/problems/valid-anagram/","file":"dsa/leetcode/arrays_and_hash/242_valid_anagram.py","symbol":"isAnagramPython","attemptDate":null,"segments":[{"kind":"container","symbol":"Solution","startLine":33,"endLine":33,"lines":["class Solution:"]},{"kind":"attempt","symbol":"isAnagramPython","startLine":65,"endLine":66,"lines":["    def isAnagramPython(self, s: str, t: str) -> bool:","        return ''.join(sorted(s)) == ''.join(sorted(t))"]}]}]}
