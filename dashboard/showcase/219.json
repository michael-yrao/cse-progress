{"schemaVersion":1,"generatedAt":"2026-10-08","entries":[{"key":"219:window-set","lcNumber":219,"variant":"window-set","title":"Contains Duplicate II","url":"https://leetcode.com/problems/contains-duplicate-ii/","file":"dsa/leetcode/sliding_window/219_contains_duplicate_ii.py","symbol":"containsNearbyDuplicate_20260704","attemptDate":"2026-07-04","segments":[{"kind":"container","symbol":"Solution","startLine":32,"endLine":32,"lines":["class Solution:"]},{"kind":"attempt","symbol":"containsNearbyDuplicate_20260704","startLine":108,"endLine":128,"lines":["    def containsNearbyDuplicate_20260704(self, nums: List[int], k: int) -> bool:","        # sliding window, use a set","","        l = r = 0","","        windowSet = set()","","        while r < len(nums):","            # check if r - l > k, if greater, we need to shrink l","            while r - l > k:","                windowSet.remove(nums[l])","                l+=1","            # now that we know we have a valid window","            # check if nums[r] already exists in window","            # if so, we return True","            if nums[r] in windowSet:","                return True","            # if not, we add nums[r] to the window","            windowSet.add(nums[r])","            r+=1","        return False"]}]}]}
