{"schemaVersion":1,"generatedAt":"2026-10-08","entries":[{"key":"229:freq-map","lcNumber":229,"variant":"freq-map","title":"Majority Element II","url":"https://leetcode.com/problems/majority-element-ii/","file":"dsa/leetcode/arrays_and_hash/229_majority_element_2.py","symbol":"majorityElement","attemptDate":null,"segments":[{"kind":"container","symbol":"Solution","startLine":31,"endLine":31,"lines":["class Solution:"]},{"kind":"attempt","symbol":"majorityElement","startLine":111,"endLine":129,"lines":["    def majorityElement(self, nums: List[int]) -> List[int]:","        # all return keys must have size bigger than minSize","        # double / for int, single / for float","        minSize = len(nums)//3","        ","        # map of n -> freq(n)","","        freqMap = defaultdict(int)","","        for n in nums:","            freqMap[n] += 1","        ","        returnList = []","","        for key, value in freqMap.items():","            if value > minSize:","                returnList.append(key)","        ","        return returnList"]}]},{"key":"229:boyer-moore","lcNumber":229,"variant":"boyer-moore","title":"Majority Element II","url":"https://leetcode.com/problems/majority-element-ii/","file":"dsa/leetcode/arrays_and_hash/229_majority_element_2.py","symbol":"majorityElementBoyerMoore","attemptDate":null,"segments":[{"kind":"container","symbol":"Solution","startLine":31,"endLine":31,"lines":["class Solution:"]},{"kind":"attempt","symbol":"majorityElementBoyerMoore","startLine":131,"endLine":168,"lines":["    def majorityElementBoyerMoore(self, nums: List[int]) -> List[int]:","        # all return keys must have size bigger than minSize","        minSize = len(nums)//3","        ","        # map of n -> freq(n)","        freqMap = defaultdict(int)","        ","        for n in nums:","            freqMap[n] += 1","            # we want to keep size of map to 2 or less","            # reason being there can only be 2 values in nums having freq > n/3","            if len(freqMap) <= 2:","                continue","            ","            # we have 3 elements in freqMap","            # so let's decrement and clean out the map","","            for n, count in freqMap.items():","                freqMap[n] = count - 1","","            # cannot iterate over a map while popping","            # thus we convert the key of the map to a list and use that to pop","            # since map is at most O(3), this is still O(1) space","            for n in list(freqMap):","                if freqMap[n] == 0:","                    freqMap.pop(n)","            ","        result = []","","        # we can't just check the map for the frequency here","        # since we have been decrementing, their true size might be bigger than minSize","","        for n in freqMap:","            # nums.count(n) is an O(n) operation but since freqMap is O(2), O(2*n) is still O(n)","            if nums.count(n) > minSize: ","                result.append(n)","        ","        return result"]}]}]}
